{
  "name": "sparcd-uploader",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "bench": "node bench/run.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:bdd": "bddgen && playwright test",
    "test:bdd:cross-tool": "bddgen --config playwright.cross-tool.config.ts && playwright test --config playwright.cross-tool.config.ts"
  },
  "dependencies": {
    "@sparcd/auth-ui": "workspace:*",
    "@sparcd/camtrap": "workspace:*",
    "@sparcd/flip": "workspace:*",
    "@sparcd/s3-safe": "workspace:*",
    "@sparcd/types": "workspace:*",
    "@tanstack/react-query": "^5.59.0",
    "@tanstack/react-virtual": "^3.10.8",
    "dexie": "^4.0.8",
    "exifr": "^7.1.3",
    "hash-wasm": "^4.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tz-lookup": "^6.1.25",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.658.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@types/tz-lookup": "^6.1.2",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "playwright-bdd": "^9.2.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "vitest": "^2.1.4"
  }
}
